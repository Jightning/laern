<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keeps the sync server running.

  Without this, `npm run sync` lives in a terminal window: closing it, logging
  out, or restarting ends sync until you remember to start it again. A phone
  syncing "whenever the laptop happens to be up" is a phone that silently stops
  syncing.

  Replace every /PATH/TO/learn below with this repo's absolute path, then:

  Install:    launchctl load -w ~/Library/LaunchAgents/com.learn.sync.plist
  Uninstall:  launchctl unload -w ~/Library/LaunchAgents/com.learn.sync.plist
  Logs:       tail -f /PATH/TO/learn/.sync/agent.log
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.learn.sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/PATH/TO/learn/tools/sync-server.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/PATH/TO/learn</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/PATH/TO/learn/.sync/agent.log</string>
  <key>StandardErrorPath</key><string>/PATH/TO/learn/.sync/agent.log</string>
</dict></plist>
